{
  "name": "pypal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PyPal: a friendly, free Python editor that runs in the browser.",
  "scripts": {
    "prepare:pyodide": "node scripts/prepare-pyodide.mjs",
    "predev": "npm run prepare:pyodide",
    "dev": "vite",
    "prebuild": "npm run prepare:pyodide",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "pyodide": "0.29.5"
  }
}
